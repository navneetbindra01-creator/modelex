        "status": "PARTIALLY_FILLED",
        "cum_qty": "100"
      }
    },
    {
      "note": "Cancel B10",
      "do": {
        "type": "CancelOrder",
        "cl_ord_id": "C1",
        "orig_cl_ord_id": "B10",
        "participant": "FIRM_A",
        "symbol": "VOD.L"
      },
      "expect": [
        {
          "exec_type": "CANCELED",
          "cl_ord_id": "C1",
          "orig_cl_ord_id": "B10"
        }
      ]
    },
    {
      "note": "Cancel an already-cancelled order",
      "do": {
        "type": "CancelOrder",
        "cl_ord_id": "C2",
        "orig_cl_ord_id": "B10",
        "participant": "FIRM_A",
        "symbol": "VOD.L"
      },
      "expect_reject": "TOO_LATE_TO_CANCEL"
    },
    {
      "note": "Cancel an unknown order",
      "do": {
        "type": "CancelOrder",
        "cl_ord_id": "C3",
        "orig_cl_ord_id": "NOPE",
        "participant": "FIRM_A",
        "symbol": "VOD.L"
      },
      "expect_reject": "UNKNOWN_ORDER"
    },
    {
      "note": "Replace qty below filled qty",
      "do": {
        "type": "ReplaceOrder",
        "cl_ord_id": "R3",
        "orig_cl_ord_id": "R2",
        "participant": "FIRM_E",
        "symbol": "VOD.L",
        "qty": "100"
      },
      "expect_reject": "INVALID_QUANTITY"
    },
    {
      "note": "Closing auction call",
      "do": {
        "type": "SetPhase",
        "schedule": "EQUITY_STD",
        "phase": "PRE_CLOSE"
      }
    },
    {
      "note": "GTC bid survives the close",
      "do": {
        "type": "NewOrder",
        "cl_ord_id": "G1",
        "participant": "FIRM_B",
        "symbol": "VOD.L",
        "side": "BUY",
        "qty": "100",
        "order_type": "LIMIT",
        "tif": "GTC",
        "price": "72.00"
      }
    },
    {
      "note": "DAY offer",
      "do": {
        "type": "NewOrder",
        "cl_ord_id": "B11",
        "participant": "FIRM_C",
        "symbol": "VOD.L",
        "side": "SELL",
        "qty": "50",
        "order_type": "LIMIT",
        "tif": "DAY",
        "price": "78.00"
      }
    },
    {
      "note": "Close: uncross (nothing crosses)",
      "do": {
        "type": "SetPhase",
        "schedule": "EQUITY_STD",
        "phase": "POST_CLOSE"
      },
      "expect_no_trades": true
    },
    {
      "note": "Market closed: DAY orders expire",
      "do": {
        "type": "SetPhase",
        "schedule": "EQUITY_STD",
        "phase": "CLOSED"
      },
      "expect": [
        {
          "cl_ord_id": "R2",
          "exec_type": "EXPIRED"
        },
        {
          "cl_ord_id": "B11",
          "exec_type": "EXPIRED"
        }
      ]
    },
    {
      "check_book": {
        "symbol": "VOD.L",
        "bids": [
          [
            "72.00",
            "100"
          ]
        ],
        "asks": []
      }
    },
    {
      "note": "Orders rejected while closed",
      "do": {
        "type": "NewOrder",
        "cl_ord_id": "X13",
        "participant": "FIRM_A",
        "symbol": "VOD.L",
        "side": "BUY",
        "qty": "100",
        "order_type": "LIMIT",
        "tif": "DAY",
        "price": "72.00"
      },
      "expect_reject": "EXCHANGE_CLOSED"
    },
    {
      "note": "Illegal transition CLOSED -> POST_CLOSE is rejected",
      "do": {
        "type": "SetPhase",
        "schedule": "EQUITY_STD",
        "phase": "POST_CLOSE"
      },
      "expect_reject": "INVALID_PHASE_TRANSITION"
    },
    {
      "check_phase": {
        "schedule": "EQUITY_STD",
        "phase": "CLOSED"
      }
    }
  ]
}
